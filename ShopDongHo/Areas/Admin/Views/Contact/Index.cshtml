@using ShopDongHo.Models
@model IEnumerable<ContactModel>

@{
    ViewData["Title"] = "List Contact";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="page-header mb-4">
        <h2>Contact Management</h2>
        <p class="text-muted">Quản lý thông tin liên hệ website</p>
    </div>

    <!-- TABLE CARD -->
    <div class="card custom-card">
        <div class="card-body">

            <table class="table custom-table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Description</th>
                        <th>Map</th>
                        <th>Logo</th>
                        <th width="120">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>

                            <!-- DESCRIPTION -->
                            <td class="desc">
                                @Html.Raw(item.Description)
                            </td>

                            <!-- MAP -->
                            <td class="map-box">
                                @Html.Raw(item.Map)
                            </td>

                            <!-- IMAGE -->
                            <td>
                                <img src="~/media/products/@item.LogoImg"
                                     class="logo-img"
                                     onerror="this.src='/images/no-image.jpg'" />
                            </td>

                            <!-- ACTION -->
                            <td>
                                <a class="btn btn-warning btn-sm" asp-controller="Contact" asp-action="Edit">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>
<style>
    /* CARD */
    .custom-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    /* TABLE */
    .custom-table thead {
        background: #f5f7fb;
    }

    .custom-table tbody tr:hover {
        background: #f9fafc;
    }

    /* DESCRIPTION */
    .desc {
        max-width: 200px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* MAP */
    .map-box iframe {
        width: 200px;
        height: 120px;
        border-radius: 8px;
    }

    /* IMAGE */
    .logo-img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #eee;
    }
</style>