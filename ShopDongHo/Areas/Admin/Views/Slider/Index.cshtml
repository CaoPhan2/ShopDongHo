@using ShopDongHo.Models
@model IEnumerable<SliderModel>

@{
    ViewData["Title"] = "List Slider";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Slider Management</h2>
            <p class="text-muted">Quản lý banner slider trang chủ</p>
        </div>

        <a class="btn btn-navy" asp-controller="Slider" asp-action="Create">
            + Add Slider
        </a>
    </div>

    <!-- TABLE CARD -->
    <div class="card custom-card">
        <div class="card-body">

            <table class="table custom-table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Image</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th width="150">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>

                            <td>
                                <strong>@item.Name</strong>
                            </td>

                            <!-- IMAGE FIX -->
                            <td>
                                <img src="~/media/sliders/@item.Image"
                                     class="slider-img"
                                     onerror="this.src='/images/no-image.jpg'" />
                            </td>

                            <td class="desc">
                                @Html.Raw(item.Description)
                            </td>

                            <!-- STATUS -->
                            <td>
                                @if (item.Status == 1)
                                {
                                    <span class="badge bg-success">Hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ẩn</span>
                                }
                            </td>

                            <!-- ACTION -->
                            <td>
                                <a class="btn btn-warning btn-sm"
                                   asp-controller="Slider"
                                   asp-action="Edit"
                                   asp-route-Id="@item.Id">
                                    Edit
                                </a>

                                <a class="btn btn-danger btn-sm confirmDeletion"
                                   asp-controller="Slider"
                                   asp-action="Delete"
                                   asp-route-Id="@item.Id">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>
<style>
    /* CARD */
    .custom-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    /* BUTTON NAVY */
    .btn-navy {
        background: #0b1f3a;
        color: white;
        border-radius: 8px;
        padding: 8px 16px;
        border: none;
    }

        .btn-navy:hover {
            background: #132c52;
        }

    /* TABLE */
    .custom-table thead {
        background: #f5f7fb;
    }

    .custom-table tbody tr:hover {
        background: #f9fafc;
    }

    /* IMAGE */
    .slider-img {
        width: 120px;
        height: 70px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #eee;
    }

    /* DESCRIPTION */
    .desc {
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* BADGE */
    .badge {
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 12px;
    }
</style>