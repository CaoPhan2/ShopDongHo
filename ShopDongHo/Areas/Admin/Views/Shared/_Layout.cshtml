<body>

	<!-- HEADER -->
	<div class="topbar">
		<div class="left">
			<i class="fa-solid fa-bars"></i>

			@* <input type="text" placeholder="Tìm kiếm..." class="search-box" /> *@
		</div>

		<div class="right">
			<i class="fa-regular fa-bell icon"></i>

			<div class="user">
				<img src="https://i.pravatar.cc/40" class="avatar" />

				<div class="info">
					<div class="name">Admin</div>
					<div class="role">Quản trị viên</div>
				</div>

				<div class="dropdown">
					<a href="#">Thông tin</a>
					<a href="#">Cài đặt</a>
					<a href="/Account/Logout">Đăng xuất</a>
				</div>
			</div>
		</div>
	</div>

	<!-- MAIN -->
	<div class="layout">

		<!-- SIDEBAR -->
		<div class="sidebar">

			<div class="logo">
				<i class="fa-regular fa-clock"></i>
				<div>
					<div style="font-size:18px;">C&P WATCH</div>
					<div style="font-size:11px; opacity:0.6;">WATCH STORE</div>
				</div>
			</div>

			<a asp-controller="Dashboard" asp-action="Index" class="menu">
				<i class="fa-solid fa-chart-line"></i> Thống kê
			</a>

			<a asp-controller="Product" asp-action="Index" class="menu">
				<i class="fa-solid fa-box"></i> Sản phẩm
			</a>

			<a asp-controller="Category" asp-action="Index" class="menu">
				<i class="fa-solid fa-layer-group"></i> Danh mục
			</a>

			<a asp-controller="Brand" asp-action="Index" class="menu">
				<i class="fa-solid fa-tags"></i> Thương hiệu
			</a>

			<a asp-controller="Order" asp-action="Index" class="menu">
				<i class="fa-solid fa-receipt"></i> Đơn hàng
			</a>

			<a asp-controller="User" asp-action="Index" class="menu">
				<i class="fa-solid fa-users"></i> Khách hàng
			</a>
			<a asp-controller="Role" asp-action="Index" class="menu">
				<i class="fa-solid fa-user"></i>Phân Quyền
			</a>

			<a asp-controller="Shipping" asp-action="Index" class="menu">
				<i class="fa-solid fa-truck"></i> Vận chuyển
			</a>

			<a asp-controller="Coupon" asp-action="Index" class="menu">
				<i class="fa-solid fa-ticket"></i> Mã giảm giá
			</a>

			<a asp-controller="Slider" asp-action="Index" class="menu">
				<i class="fa-solid fa-images"></i> Slider
			</a>

			<a asp-controller="Contact" asp-action="Index" class="menu">
				<i class="fa-solid fa-envelope"></i> Liên hệ
			</a>
			<a asp-area="Client" asp-controller="Home" asp-action="Index" class="menu">
				<i class="fa-solid fa-house"></i> Trang chủ
			</a>
			<div class="logout">
				<a href="/Account/Logout">
					<i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
				</a>
			</div>

		</div>

		<!-- CONTENT -->
		<div class="content">
			@Html.Partial("_NotificationPartial")

			<div class="card">
				@RenderBody()
			</div>
		</div>

	</div>
	



</body>



<script src="~/js/jquery.js"></script>
<script src="~/js/bootstrap.min.js"></script>
