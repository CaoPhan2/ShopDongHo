<script src="~/js/jquery.prettyPhoto.js"></script>
<script src="~/js/main.js"></script>
<script src="~/backend/js/site.js"></script>
<script src="//cdn.datatables.net/2.3.7/js/dataTables.min.js"></script>

<script src="https://cdn.datatables.net/buttons/3.2.6/js/dataTables.buttons.js"></script>
<script src="https://cdn.datatables.net/buttons/3.2.6/js/buttons.dataTables.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/3.2.6/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.2.6/js/buttons.print.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.22/dist/sweetalert2.all.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/raphael/2.1.0/raphael-min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/morris.js/0.5.1/morris.min.js"></script>
<script>
	const links = document.querySelectorAll(".menu");
	const currentUrl = window.location.pathname.toLowerCase();

	links.forEach(link => {
		const href = link.getAttribute("href").toLowerCase();

		// Xóa active trước
		link.classList.remove("active");

		// So sánh CHÍNH XÁC hoặc bắt đầu bằng
		if (currentUrl === href || currentUrl.startsWith(href + "/")) {
			link.classList.add("active");
		}
	});
</script>
<script>
	const user = document.querySelector(".user");
	const dropdown = document.querySelector(".dropdown");

	user.addEventListener("click", () => {
		dropdown.classList.toggle("show");
	});

	document.addEventListener("click", function(e) {
		if (!user.contains(e.target)) {
			dropdown.classList.remove("show");
		}
	});
</script>
<script>
	$(function (){
		var message = '@TempData["success"]';
		if(message != '')
		   Swal.fire(message);
	});
</script>
<script>
	let table = new DataTable('#myTable', {
		layout: {
			topStart: {
				buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
			}
		}
	});
</script>
	@await RenderSectionAsync("Scripts", required: false)

</html>