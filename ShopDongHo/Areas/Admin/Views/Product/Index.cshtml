@using ShopDongHo.Models
@model IEnumerable<ProductModel>

@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="product-container">

    <!-- HEADER -->
    <div class="product-header">
        <h1>Quản lý sản phẩm</h1>
        <a class="btn-main" asp-controller="Product" asp-action="Create">
            + Thêm sản phẩm
        </a>
    </div>

    <!-- TABLE -->
    <div class="product-card">
        <table class="table product-table" id="myTable">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Sản phẩm</th>
                    <th>Giá</th>
                    <th>Kho</th>
                    <th>Đã bán</th>
                    <th>Danh mục</th>
                    <th>Thương hiệu</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Id</td>

                        <!-- PRODUCT -->
                        <td>
                            <div class="product-infor">
                                <img src="~/media/products/@item.Images" />

                                <div>
                                    <div class="p-name">@item.Name</div>
                                    <div class="p-desc">
                                        @Html.Raw(item.Description)
                                    </div>
                                    <span class="p-desc-toggle">Xem thêm</span>
                                </div>
                            </div>
                        </td>

                        <!-- PRICE -->
                        <td>
                            <div class="p-price">
                                @item.Price.ToString("#,##0") đ
                                <small>
                                    Cost: @item.CapitalPrice.ToString("#,##0")
                                </small>
                            </div>
                        </td>

                        <!-- QUANTITY -->
                        <td>
                            <div class="p-qty">
                                <b>@item.Quantity</b>
                                <a asp-controller="Product"
                                   asp-action="AddQuantity"
                                   asp-route-id="@item.Id">
                                    + nhập
                                </a>
                            </div>
                        </td>

                        <td><b>@item.Sold</b></td>

                        <!-- CATEGORY -->
                        <td>
                            <span class="badge badge-category">
                                @item.Category.Name
                            </span>
                        </td>

                        <!-- BRAND -->
                        <td>
                            <span class="badge badge-brand">
                                @item.Brand.Name
                            </span>
                        </td>

                        <!-- ACTION -->
                        <td>
                            <div class="p-action">
                                <a class="btn-edit"
                                   asp-controller="Product"
                                   asp-action="Edit"
                                   asp-route-Id="@item.Id">
                                    Sửa
                                </a>

                                <a class="btn-delete confirmDeletion"
                                   asp-controller="Product"
                                   asp-action="Delete"
                                   asp-route-Id="@item.Id">
                                    Xóa
                                </a>
                            </div>
                        </td>

                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>

<script>
    document.querySelectorAll('.p-desc').forEach(function(desc) {

        // Ẩn nút nếu mô tả ngắn
        if (desc.innerText.length < 100) {
            desc.nextElementSibling.style.display = 'none';
            return;
        }

        desc.nextElementSibling.addEventListener('click', function() {

            desc.classList.toggle('expanded');

            this.innerText = desc.classList.contains('expanded')
                ? 'Thu gọn'
                : 'Xem thêm';
        });
    });
</script>
<style>
    /* CONTAINER */
    .product-container {
        padding: 25px;
        background: #f7f9fc;
    }

    /* HEADER */
    .product-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .product-header h1 {
            font-size: 24px;
            font-weight: 600;
            color: #0b1f3a;
        }

    /* BUTTON */
    .btn-main {
        background: #0b1f3a;
        color: #fff;
        padding: 10px 15px;
        border-radius: 10px;
        text-decoration: none;
    }

        .btn-main:hover {
            background: #142f55;
        }

    /* CARD */
    .product-card {
        margin-top: 20px;
        background: #fff;
        padding: 20px;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    /* TABLE */
    .product-table thead {
        background: #0b1f3a;
        color: #fff;
    }

    .product-table th {
        border: none;
        padding: 12px;
    }

    .product-table tbody tr:hover {
        background: #f8f9fc;
    }

    /* PRODUCT INFO */
    .product-infor {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .product-infor img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 10px;
        }

    /* NAME + DESC */
    .p-name {
        font-weight: 500;
        color: #0b1f3a;
    }

    .p-desc {
        font-size: 12px;
        color: #777;
        max-width: 200px;
        max-height: 150px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        overflow: hidden;
    }

    /* PRICE */
    .p-price {
        font-weight: 500;
        color: #0b1f3a;
    }

        .p-price small {
            display: block;
            font-size: 12px;
            color: #888;
        }

    /* QUANTITY */
    .p-qty a {
        display: block;
        font-size: 12px;
        color: #0b1f3a;
    }

    /* BADGE */
    .badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .badge-category {
        background: #e7f0ff;
        color: #0d6efd;
    }

    .badge-brand {
        background: #f0f0f0;
        color: #333;
    }

    /* ACTION */
    .p-action {
        display: flex;
        gap: 8px;
    }

    .btn-edit {
        padding: 5px 10px;
        border-radius: 8px;
        background: #ffc107;
        color: #000;
        text-decoration: none;
    }

    .btn-delete {
        padding: 5px 10px;
        border-radius: 8px;
        border: 1px solid #dc3545;
        color: #dc3545;
        text-decoration: none;
    }

        .btn-delete:hover {
            background: #dc3545;
            color: #fff;
        }


    .p-desc {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 5;
        overflow: hidden;
    }

    .p-desc.expanded {
        display: block;
        -webkit-line-clamp: unset;
        max-height: none;
        overflow: visible;
    }
    .p-desc-toggle {
        color: #007bff;
        cursor: pointer;
        font-size: 12px;
    }
</style>