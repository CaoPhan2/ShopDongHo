@using ShopDongHo.Models
@model ProductQuantityModel
@{
    ViewData["Title"] = "Create Quantity";
    var total_quantites = 0;
    var key = 1;
}

<div class="container mt-4">

    <!-- TITLE -->
    <div class="page-header mb-4">
        <h2>Thêm Số Lượng Sản Phẩm</h2>
        <p class="text-muted">Thêm số lượng sản phẩm vào kho</p>
    </div>

    <!-- FORM CARD -->
    <div class="card custom-card mb-4">
        <div class="card-body">
            <form asp-action="StoreProductQuantity" asp-controller="Product">
                <input type="hidden" name="ProductId" value="@ViewBag.Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label class="form-label">Số Lượng</label>
                    <input min="1" value="1" max="5000" asp-for="Quantity" class="form-control custom-input" />
                    <small class="text-muted">Nhập từ 1 → 5000</small>
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <button class="btn btn-navy">
                    + Cập Nhật
                </button>
            </form>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="card custom-card">
        <div class="card-body">
            <h5 class="mb-3">Lịch sử cập nhật</h5>

            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Số Lượng Đã Thêm</th>
                        <th>Ngày</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pq in ViewBag.ProductByQuantity)
                    {
                        total_quantites += pq.Quantity;
                        <tr>
                            <td>@key</td>
                            <td>@pq.Quantity</td>
                            <td>@pq.DateCreated</td>
                        </tr>
                        key++;
                    }
                </tbody>
            </table>

            <div class="total-box">
                Tổng Số: <strong>@total_quantites</strong>
            </div>
        </div>
    </div>

    <!-- BACK -->
    <div class="mt-3">
        <a asp-controller="Product" asp-action="Index" class="back-link">
            ← Quay lại danh sách sản phẩm
        </a>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<style>
    /* ===== GENERAL ===== */
    body {
        background: #f5f7fb;
        font-family: 'Segoe UI', sans-serif;
    }

    /* ===== HEADER TEXT ===== */
    .page-header h2 {
        font-weight: 600;
        color: #0b1f3a;
    }

    /* ===== CARD ===== */
    .custom-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    /* ===== INPUT ===== */
    .custom-input {
        border-radius: 8px;
        padding: 10px;
        border: 1px solid #dcdfe6;
    }

        .custom-input:focus {
            border-color: #0b1f3a;
            box-shadow: 0 0 0 2px rgba(11,31,58,0.1);
        }

    /* ===== BUTTON ===== */
    .btn-navy {
        background: #0b1f3a;
        color: white;
        border-radius: 8px;
        padding: 10px 20px;
        border: none;
        transition: 0.3s;
    }

        .btn-navy:hover {
            background: #132c52;
        }

    /* ===== TABLE ===== */
    .custom-table thead {
        background: #f0f2f7;
    }

    .custom-table th {
        color: #0b1f3a;
        font-weight: 600;
    }

    .custom-table tbody tr:hover {
        background: #f9fafc;
    }

    /* ===== TOTAL BOX ===== */
    .total-box {
        margin-top: 15px;
        padding: 10px;
        background: #eef2f8;
        border-radius: 8px;
        font-weight: 500;
        color: #0b1f3a;
    }

    /* ===== BACK LINK ===== */
    .back-link {
        color: #0b1f3a;
        text-decoration: none;
        font-weight: 500;
    }

        .back-link:hover {
            text-decoration: underline;
        }
</style>