@using ShopDongHo.Models
@model ProductModel
@{
    ViewData["Title"] = "Create Product";
}

<section class="create-product-section">

    <div class="create-product-box">
        <h2>Thêm sản phẩm</h2>

        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label>Tên sản phẩm</label>
                <input asp-for="Name" class="form-control" id="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Giá</label>
                <input asp-for="Price" id="Price" pattern="[0-9.,]+" class="form-control typing-price" />
                <span class="price-convert text-muted"></span>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            

            <div class="form-group">
                <label>Giá vốn</label>
                <input asp-for="CapitalPrice" pattern="[0-9.,]+" class="form-control typing-price" />
                <span class="price-convert text-muted"></span>
                <span asp-validation-for="CapitalPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Số lượng</label>
                <input asp-for="Quantity" id="Quantity" pattern="[0-9.,]+" class="form-control" />
                <span class="price-convert text-muted"></span>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Thông số kỹ thuật</label>
                <textarea id="ExtraInfo" class="form-control" rows="3" placeholder="Ví dụ: Dây da màu đen, chống nước 50m..."></textarea>
            </div>
            

            <div class="form-group">
                <label>Danh mục</label>
                <select asp-for="CategoryId" id="CategoryId" class="form-control" asp-items="ViewBag.Categories">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Thương hiệu</label>
                <select asp-for="BrandId" id="BrandId" class="form-control" asp-items="ViewBag.Brands">
                    <option value="">-- Chọn thương hiệu --</option>
                </select>
                <span asp-validation-for="BrandId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Mô tả</label>
                <textarea asp-for="Description" id="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
                <button type="button" id="btnGenerateDescription" class="btn btn-primary mt-2">
                    Tạo mô tả bằng AI
                </button>

            </div>
            <div class="form-group">
                <label>Hình ảnh</label>
                <input asp-for="ImageUpload" type="file" class="form-control" />
                <span asp-validation-for="ImageUpload" class="text-danger"></span>
                <img id="imgpreview" />
            </div>

            <button type="submit" class="btn-create">Thêm</button>
        </form>

        <a asp-action="Index" class="back-link">← Quay lại danh sách</a>
    </div>

</section>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // preview ảnh
        $("#ImageUpload").change(function () {
            const reader = new FileReader();
            reader.onload = function (e) {
                $("#imgpreview").attr("src", e.target.result);
            };
            reader.readAsDataURL(this.files[0]);
        });

        // CKEditor
        CKEDITOR.replace('Description');

        // format giá (fix chuẩn)
        $(".typing-price").on("keyup", function () {
            let value = $(this).val().replace(/[^0-9]/g, "");
            let formatted = new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(value);

            $(this).closest(".form-group").find(".price-convert").html(formatted);
        });
    </script>

    <script>
        $("#btnGenerateDescription").click(function () {

            let btn = $(this);

            btn.prop("disabled", true);
            btn.text("AI đang viết...");

            $.ajax({
                url: "/Admin/Product/GenerateDescription",
                type: "POST",
                data: {
                    name: $("#Name").val(),
                    price: $("#Price").val(),
                    category: $("#CategoryId option:selected").text(),
                    brand: $("#BrandId option:selected").text(),
                    extraInfo: $("#ExtraInfo").val()
                },
                success: function (res) {

                    $("#Description").val(res.description);

                    btn.prop("disabled", false);
                    btn.text("Tạo mô tả bằng AI");
                },
                error: function () {

                    alert("Không thể kết nối AI");

                    btn.prop("disabled", false);
                    btn.text("Tạo mô tả bằng AI");
                }
            });
        });
    </script>
}
<style>
    .create-product-section {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f5f5f5;
        padding: 20px;
    }

    .create-product-box {
        width: 100%;
        max-width: 600px;
        background: #fff;
        padding: 25px;
        border-radius: 8px;
        border: 1px solid #eee;
    }

        .create-product-box h2 {
            text-align: center;
            margin-bottom: 20px;
        }

    .form-group {
        margin-bottom: 15px;
    }

    .form-control {
        width: 100%;
        height: 42px;
        border-radius: 6px;
        border: 1px solid #ddd;
        padding: 0 10px;
    }

    textarea.form-control {
        height: 100px;
        padding: 10px;
    }

    .btn-create {
        width: 100%;
        height: 42px;
        background: #0b1f3a;
        color: #fff;
        border: none;
        border-radius: 6px;
        margin-top: 10px;
    }

        .btn-create:hover {
            background: #222;
        }

    #imgpreview {
        display: block;
        margin-top: 10px;
        max-width: 120px;
        border-radius: 6px;
    }

    .back-link {
        display: block;
        margin-top: 15px;
        text-align: center;
        color: #555;
        text-decoration: none;
    }
</style>