@using ShopDongHo.Models
@model ProductModel
@{
    ViewData["Title"] = "Create Product";
}

<section class="create-product-section">

    <div class="create-product-box">
        <h2>Create Product</h2>

        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label>Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Price</label>
                <input asp-for="Price" pattern="[0-9.,]+" class="form-control typing-price" />
                <span class="price-convert text-muted"></span>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Capital Price</label>
                <input asp-for="CapitalPrice" pattern="[0-9.,]+" class="form-control typing-price" />
                <span class="price-convert text-muted"></span>
                <span asp-validation-for="CapitalPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Category</label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
                    <option value="">-- Choose category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Brand</label>
                <select asp-for="BrandId" class="form-control" asp-items="ViewBag.Brands">
                    <option value="">-- Choose brand --</option>
                </select>
                <span asp-validation-for="BrandId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Image</label>
                <input asp-for="ImageUpload" type="file" class="form-control" />
                <span asp-validation-for="ImageUpload" class="text-danger"></span>
                <img id="imgpreview" />
            </div>

            <button type="submit" class="btn-create">Create Product</button>
        </form>

        <a asp-action="Index" class="back-link">← Back to list</a>
    </div>

</section>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // preview ảnh
        $("#ImageUpload").change(function () {
            const reader = new FileReader();
            reader.onload = function (e) {
                $("#imgpreview").attr("src", e.target.result);
            };
            reader.readAsDataURL(this.files[0]);
        });

        // CKEditor
        CKEDITOR.replace('Description');

        // format giá (fix chuẩn)
        $(".typing-price").on("keyup", function () {
            let value = $(this).val().replace(/[^0-9]/g, "");
            let formatted = new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(value);

            $(this).closest(".form-group").find(".price-convert").html(formatted);
        });
    </script>
}
<style>
    .create-product-section {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f5f5f5;
        padding: 20px;
    }

    .create-product-box {
        width: 100%;
        max-width: 600px;
        background: #fff;
        padding: 25px;
        border-radius: 8px;
        border: 1px solid #eee;
    }

        .create-product-box h2 {
            text-align: center;
            margin-bottom: 20px;
        }

    .form-group {
        margin-bottom: 15px;
    }

    .form-control {
        width: 100%;
        height: 42px;
        border-radius: 6px;
        border: 1px solid #ddd;
        padding: 0 10px;
    }

    textarea.form-control {
        height: 100px;
        padding: 10px;
    }

    .btn-create {
        width: 100%;
        height: 42px;
        background: #0b1f3a;
        color: #fff;
        border: none;
        border-radius: 6px;
        margin-top: 10px;
    }

        .btn-create:hover {
            background: #222;
        }

    #imgpreview {
        display: block;
        margin-top: 10px;
        max-width: 120px;
        border-radius: 6px;
    }

    .back-link {
        display: block;
        margin-top: 15px;
        text-align: center;
        color: #555;
        text-decoration: none;
    }
</style>