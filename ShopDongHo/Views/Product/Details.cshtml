@using ShopDongHo.Models
@using ShopDongHo.Models.ViewModel
@model ProductDetailViewModel
<div class="row">
	<div class="col-sm-3">
		@Html.Partial("_SidebarPartial")
	</div>

	<div class="col-sm-9 padding-right">
		<div class="product-details">
			<!--product-details-->
			<div class="col-sm-5">
				<div class="view-product">
					<img src="@Url.Content("~/media/products/" + Model.ProductDetails.Images)"
						 alt="@Model.ProductDetails.Name"
						 width="100%"
						 onerror="this.onerror=null; this.src='@Url.Content("~/images/no-image.jpg")';" />
					
					@* <h3>ZOOM</h3> *@
				</div>
				@* <div id="similar-product" class="carousel slide" data-ride="carousel">

					<!-- Wrapper for slides -->
					<div class="carousel-inner">
						<div class="item active">
							<a href=""><img src="images/product-details/similar1.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar2.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar3.jpg" alt=""></a>
						</div>
						

					</div>

					<!-- Controls -->
					<a class="left item-control" href="#similar-product" data-slide="prev">
						<i class="fa fa-angle-left"></i>
					</a>
					<a class="right item-control" href="#similar-product" data-slide="next">
						<i class="fa fa-angle-right"></i>
					</a>
				</div> *@

			</div>
			<div class="col-sm-7">
				<div class="product-detail">

					<div class="product-info">
						<div>
							<span class="brand">@Model.ProductDetails.Brand.Name</span> - 
                            <span class="category">@Model.ProductDetails.Category.Name</span>
						</div>
						<h1 class="product-name">@Model.ProductDetails.Name</h1>
						<span>Mã sản phẩm: @Model.ProductDetails.Id
							
						</span>  ||  
						Tình trạng: @if (@Model.ProductDetails.Quantity > 5)
							{
							<span class="text text-success">Còn hàng</span>
						}
						else
						{
							<span class="text text-danger">Hết hàng</span>
						}

						

						<div class="price">@Model.ProductDetails.Price.ToString("#,##0đ")</div>

						<div class="desc">
							<h5>Mô tả sản phẩm: </h5>
							<p>@Html.Raw(Model.ProductDetails.Description)</p>
						</div>
						<div class="policy">
							<p>✔ 100% chính hãng, bảo hành 12 tháng</p>
							<p>✔ Miễn phí vận chuyển đơn từ 1.000.000đ</p>
							<p>✔ Đổi trả trong 7 ngày</p>
							<p>✔ Thanh toán khi nhận hàng (COD)</p>
						</div>

						<div class="quantity">
							<label>Số lượng: </label>
							<div class="qty-box">
								<button>-</button>
								<input type="text" value="1" />
								<button>+</button>
							</div>
						</div>

						<div class="actions">
							@if (@Model.ProductDetails.Quantity > 0)
							{
								<button class="btn-add-cart" data-product_id="@Model.ProductDetails.Id">
									<i class="fa fa-shopping-cart"></i> Thêm vào giỏ hàng
								</button>
							}
							else
							{
								<button class="btn-disabled">
									<i class="fa fa-shopping-cart"></i> Hết hàng
								</button>
							}

							<a class="btn-buy" data-product_id="@Model.ProductDetails.Id" asp-controller="Checkout"
							   asp-action="Checkout">Mua ngay</a>
						</div>

						
					</div>

				</div>
			</div>
		</div><!--/product-details-->

		<div class="category-tab shop-details-tab">
			<!--category-tab-->
			<div class="col-sm-12">
				<ul class="nav nav-tabs">
					<li><a href="#details" data-toggle="tab">Thông tin sản phẩm</a></li>
					<li><a href="#tag" data-toggle="tab">Hướng dẫn chọn size</a></li>
					<li class="active"><a href="#reviews" data-toggle="tab">Đánh giá (5)</a></li>
				</ul>
			</div>
			<div class="tab-content">
				<div class="tab-pane fade in" id="details">
					<p>Thương hiệu sản phẩm: @Model.ProductDetails.Brand.Name</p>
                    <p>Danh mục: @Model.ProductDetails.Category.Name</p>
					<p>Mô tả sản phẩm:  @Html.Raw(Model.ProductDetails.Description)</p>
					<p>Giá : @Model.ProductDetails.Price đ</p>
					<p>Số lượng kho : @Model.ProductDetails.Quantity</p>
					
				</div>

				

				<div class="tab-pane fade" id="tag">
					
					
				</div>

				<div class="tab-pane fade active in" id="reviews">
					<div class="col-sm-6">
						<div class="review-wrapper">
							<ul>
								<li><a href=""><i class="fa fa-user"></i>EUGEN</a></li>
								<li><a href=""><i class="fa fa-clock-o"></i>12:41 PM</a></li>
								<li><a href=""><i class="fa fa-calendar-o"></i>31 DEC 2014</a></li>
							</ul>

							<p><b>Viết đánh giá</b></p>

							<form autocomplete="off" asp-action="CommentProduct" asp-controller="Product">

								<span>

									<input asp-for="@Model.ProductDetails.Id"
										   name="ProductId"
										   type="hidden" />

									<input asp-for="@Model.Name"
										   type="text"
										   placeholder="Họ Tên" />

									<span asp-validation-for="@Model.Name"
										  class="text-danger"></span>

									<input asp-for="@Model.Email"
										   type="email"
										   placeholder="Nhập Email" />

									<span asp-validation-for="@Model.Email"
										  class="text-danger"></span>

								</span>
								<b>Chọn mức độ hài lòng:</b>

								<div class="rating-stars">

									@for (int i = 1; i <= 5; i++)
									{
										<i class="fa-regular fa-star star"
										   data-value="@i"></i>
									}

								</div>

								<input type="hidden"
									   id="rating-value"
									   name="Star"
									   value="0">
								<textarea asp-for="@Model.Comment"></textarea>
								<span asp-validation-for="@Model.Comment"
									  class="text-danger"></span>

								<button type="submit"
										class="btn btn-default">
									Gửi đánh giá
								</button>

							</form>
						</div>
					</div>
					<div class="col-sm-6">
						<div class="review-wrapper">

							<h3>Đánh giá của khách hàng:</h3>

							<div class="review-list">
								@if (Model.ProductDetails.Ratings != null && Model.ProductDetails.Ratings.Any())
								{
									@foreach (var item in Model.ProductDetails.Ratings)
									{
										<div class="review-item">

											<h5>Họ Tên: @item.Name</h5>
											

											<div class="review-stars">
												@for (int i = 1; i <= 5; i++)
												{
													if (i <= item.Star)
													{
														<i class="fa-solid fa-star text-warning"></i>
													}
													else
													{
														<i class="fa-regular fa-star text-warning"></i>
													}
												}
											</div>

											<p>Nội dung: @item.Comment</p>
                                            <p class="review-date">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                               
										</div>
									}
								}
								else
								{
                                    <p>Chưa có đánh giá nào cho sản phẩm này.</p>
									<p>Hãy trở thành người đầu tiên đánh giá sản phẩm!</p>
								}
							</div>

						</div>
					</div>
				</div>

			</div>
		</div><!--/category-tab-->

		<div class="recommended_items">
			<!--recommended_items-->
			<h2 class="title text-center">Sản Phẩm Liên Quan</h2>

			<div id="recommended-item-carousel" class="carousel slide" data-ride="carousel">
				<div class="carousel-inner">
					<div class="item active">
						@foreach (var item in ViewBag.RelatedProducts as IEnumerable<ProductModel>)
						{
							<div class="col-lg-3 col-md-4 col-sm-6">
								<partial name="_ProductItemCard" model="item" />
							</div>
						}

						
					</div>
					
				</div>
				<a class="left recommended-item-control" href="#recommended-item-carousel" data-slide="prev">
					<i class="fa fa-angle-left"></i>
				</a>
				<a class="right recommended-item-control" href="#recommended-item-carousel" data-slide="next">
					<i class="fa fa-angle-right"></i>
				</a>
			</div>
		</div><!--/recommended_items-->

	</div>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>
		$(document).ready(function (){
			$('.btn-add-cart').click(function(){
				var Id = $(this).data('product_id');

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCart", "Cart")",
					data: {Id: Id}, // Dữ liệu được gửi đến server

					success: function (result){
						if(result){
							Swal.fire({
								toast: true,
								position: 'top-end',
								icon: 'success',
								title: 'Đã thêm vào giỏ hàng',
								showConfirmButton: false,
								timer: 1500
							});
						}
					},
				});
			});
		});
	</script>
	<script>
		$(document).ready(function (){
			$('.btn-buy').click(function(){
				var Id = $(this).data('product_id');

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCart", "Cart")",
					data: {Id: Id}, // Dữ liệu được gửi đến server

					success: function (result){
						if(result){
							window.location.href = "@Url.Action("Index", "Cart")";
						}
					},
				});
			});
		});
	</script>
	<script>

		const stars = document.querySelectorAll('.star');
		const ratingInput = document.getElementById('rating-value');

		stars.forEach(star => {

			star.addEventListener('click', function () {

				let value = this.dataset.value;

				ratingInput.value = value;

				stars.forEach(s => {
					s.classList.remove('fa-solid');
					s.classList.add('fa-regular');
				});

				for (let i = 0; i < value; i++) {
					stars[i].classList.remove('fa-regular');
					stars[i].classList.add('fa-solid');
				}

			});

		});

	</script>
}
