        cursor: pointer;
        transition: color 0.2s;
    }

        .chat-header-close:hover {
            color: #fff;
        }

    .chat-body {
        flex: 1;
        padding: 16px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: #f4f6f8;
    }

    .msg-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        width: 100%;
    }

        .msg-row.user {
            flex-direction: row-reverse;
        }

    .bot-msg-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #FE980F;
        display: flex;
