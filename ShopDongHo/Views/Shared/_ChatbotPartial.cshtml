<div id="chat-bubble" class="ai-pro-bubble">

    <div class="ai-pulse-ring"></div>
    <div class="ai-pulse-ring delay"></div>


    <div class="ai-core-icon">
        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M32 12C20.9543 12 12 20.9543 12 32C12 43.0457 20.9543 52 32 52C43.0457 52 52 43.0457 52 32C52 20.9543 43.0457 12 32 12Z" stroke="url(#ai-gradient)" stroke-width="3" stroke-linecap="round" />
            <path d="M22 32C22 26.4772 26.4772 22 32 22C37.5228 22 42 26.4772 42 32C42 37.5228 37.5228 42 32 42" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" />
            <circle cx="32" cy="32" r="5" fill="#FFFFFF" class="ai-dot-blink" />
            <path d="M16 32H20M44 32H48M32 16V20M32 44V48" stroke="url(#ai-gradient)" stroke-width="3" stroke-linecap="round" />
            <defs>
                <linearGradient id="ai-gradient" x1="12" y1="12" x2="52" y2="52" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#FFB347" />
                    <stop offset="1" stop-color="#FE980F" />
                </linearGradient>
            </defs>
        </svg>
    </div>

    <div class="ai-status-badge">
        <span class="badge-dot"></span>
        <span>TRỢ LÝ AI</span>
    </div>
</div>

<div id="chat-box">
    <div class="chat-header">
        <div class="chat-header-avatar">🤖</div>
        <div class="chat-header-info">
            <div class="chat-header-name">Trợ lý ảo C&P Store</div>
            <div class="chat-header-status">
                <span class="status-dot"></span> Đang trực tuyến
            </div>
        </div>
        <button class="chat-header-close" onclick="toggleChat()">✕</button>
    </div>

    <div class="chat-body" id="chat-body">
        <div class="msg-row">
            <div class="bot-msg-avatar">🤖</div>
            <div class="bubble-wrap bot">
                <div class="bubble bot">Xin chào! Mình là trợ lý AI thông minh của C&P Store 🛍️ Bạn cần tìm đồng hồ theo khoảng giá, phong cách, thương hiệu nào cứ nhắn mình hỗ trợ nhé!</div>
                <span class="bubble-time" id="welcome-time">00:00</span>
            </div>
        </div>
    </div>

    <div id="quick-messages">
        <button onclick="quickSend('Đồng hồ dưới 3 triệu')">⌚ Dưới 3 triệu</button>
        <button onclick="quickSend('Đồng hồ nam thể thao')">🏃 Thể thao</button>
        <button onclick="quickSend('Đồng hồ nữ sang trọng')">👩 Mẫu Nữ</button>
        <button onclick="quickSend('Tìm đồng hồ Casio')">🔍 Hiệu Casio</button>
    </div>

    <div class="chat-footer">
        <input type="text" id="user-input" placeholder="Hỏi AI về sản phẩm, giá cả..." onkeydown="if(event.key==='Enter') sendMessage()" />
        <button class="btn-send" onclick="sendMessage()" aria-label="Gửi">➤</button>
    </div>
</div>

<script>
    // 1. CHUYỂN SANG LOCALSTORAGE ĐỂ GIỮ PHIÊN CHAT KHI RESET TRANG (F5)
    const sessionId = localStorage.getItem('chatSessionId')
        ?? (() => {
            const id = "session_" + Date.now() + "_" + Math.random().toString(36).substr(2, 9);
            localStorage.setItem('chatSessionId', id);
            return id;
        })();

    const bubble = document.getElementById("chat-bubble");
    const chatBox = document.getElementById("chat-box");
    const chatBody = document.getElementById("chat-body");

    document.getElementById("welcome-time").innerText = now();
    bubble.onclick = () => { toggleChat(); };

    function toggleChat() {
        chatBox.style.display = chatBox.style.display === 'flex' ? 'none' : 'flex';
        chatBody.scrollTop = chatBody.scrollHeight;
    }

    function now() {
        const d = new Date();
        return d.getHours() + ':' + String(d.getMinutes()).padStart(2, '0');
    }

    function addMessage(html) {
        const temp = document.createElement('div');
        temp.innerHTML = html;
        chatBody.appendChild(temp.firstElementChild);
        chatBody.scrollTop = chatBody.scrollHeight;
        return chatBody.lastElementChild;
    }

    function typeWriterEffect(element, text, speed, callback) {
        let i = 0;
        element.innerHTML = "";
        const timer = setInterval(() => {
            if (i < text.length) {
                element.innerHTML += text.charAt(i);
                i++;
                chatBody.scrollTop = chatBody.scrollHeight;
            } else {
                clearInterval(timer);
                if (callback) callback();
            }
        }, speed);
    }


    async function loadHistory() {
        try {
            // Gọi đúng endpoint GetHistory của ChatController
            const res = await fetch(`/Chat/GetHistory?sessionId=${sessionId}`);
            const data = await res.json();

            if (!data.success || !data.messages || data.messages.length === 0) return;

            // Ẩn tin nhắn nhanh nếu đã có lịch sử trò chuyện cũ
            document.getElementById("quick-messages").style.display = "none";

            data.messages.forEach(h => {
                // Hiển thị tin nhắn của User từ lịch sử
                if (h.userMessage) {
                    addMessage(`
                        <div class="msg-row user">
                            <div class="bubble-wrap user">
                                <div class="bubble user">${escapeHtml(h.userMessage)}</div>
                                <span class="bubble-time">${h.createdAt}</span>
                            </div>
                        </div>
                    `);
                }

                // Hiển thị tin nhắn của Bot từ lịch sử
                if (h.botReply) {
                    let cleanReply = h.botReply.replace(/\[PRODUCT_CARD\][\s\S]*?\[\/PRODUCT_CARD\]/g, '').trim();

                    // Tách câu chốt tư vấn nếu có để hiển thị đẹp mắt
                    const closingText = "Anh/chị có muốn em tư vấn thêm về mẫu đồng hồ này, hoặc cần xem thêm các sản phẩm khác không ạ?";
                    let mainContent = cleanReply;
                    let finalAskHtml = "";

                    if (cleanReply.includes(closingText)) {
                        mainContent = cleanReply.replace(closingText, '').trim();
                        finalAskHtml = `<span style="display: block; margin-top: 8px; border-top: 1px dashed #e2e8f0; padding-top: 10px;">${closingText}</span>`;
                    }

                    // Tái dựng danh sách sản phẩm (Card) cũ lồng bên trong Bubble Chat
                    let productsHtml = "";
                    if (h.products && h.products.length > 0) {
                        productsHtml = `<div class="product-vertical-list inside-bubble" style="margin: 6px 0 10px 0;">`;
                                h.products.forEach(p => {
                                    productsHtml += `
                                        <div class="product-grid-card visible" onclick="window.location.href='/Product/Details/${p.id}'">
                                            <div class="card-thumb-wrap">
                                                <img src="${p.imageUrl}" alt="${p.name}" onerror="this.onerror=null; this.src='/images/no-image.jpg';">

                                                <button class="card-heart-btn" onclick="event.stopPropagation(); handleAddToWishlist(this, ${p.id});">
                                                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                                                </button>
                                            </div>
                                            <div class="card-body-info">
                                                <h4 class="card-product-name" title="${p.name}">${p.name}</h4>
                                                <p class="card-brand-name">Thương hiệu: ${p.brandName || 'Đang cập nhật'}</p>
                                                <div class="card-footer-row">
                                                    <span class="card-product-price">${p.price.toLocaleString('vi-VN')}đ</span>

                                                    <button class="card-cart-btn" onclick="event.stopPropagation(); handleAddToCart(${p.id});">
                                                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                });
                        productsHtml += `</div>`;
                    }

                    addMessage(`
                        <div class="msg-row">
                            <div class="bot-msg-avatar">🤖</div>
                            <div class="bubble-wrap bot" style="max-width: 82%;">
                                <div class="bubble bot" style="width: 100%; display: flex; flex-direction: column; gap: 4px;">
                                    <span style="white-space: pre-line;">${mainContent}</span>
                                    ${productsHtml}
                                    ${finalAskHtml}
                                </div>
                                <span class="bubble-time">${h.createdAt}</span>
                            </div>
                        </div>
                    `);
                }
            });
            chatBody.scrollTop = chatBody.scrollHeight;
        } catch (e) {
            console.error("Lỗi đồng bộ lịch sử từ Database:", e);
        }
    }

    async function sendMessage() {
        const input = document.getElementById("user-input");
        const message = input.value.trim();
        if (!message) return;

        document.getElementById("quick-messages").style.display = "none";

        addMessage(`
            <div class="msg-row user">
                <div class="bubble-wrap user">
                    <div class="bubble user">${escapeHtml(message)}</div>
                    <span class="bubble-time">${now()}</span>
                </div>
            </div>
        `);
        input.value = "";

        addMessage(`
            <div class="msg-row" id="loading-message">
                <div class="bot-msg-avatar">🤖</div>
                <div class="bubble-wrap bot">
                    <div class="typing-dots">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        `);

        try {
            const response = await fetch('/Chat/Ask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    message: message,
                    sessionId: sessionId
                })
            });

            const contentType = response.headers.get('content-type') || '';
            let data = null;

            if (response.ok && contentType.includes('application/json')) {
                data = await response.json();
            } else {
                showErrorMsg("⚠️ Máy chủ gặp sự cố xử lý hoặc phản hồi sai định dạng.");
                return;
            }

            document.getElementById("loading-message")?.remove();

            const uniqueId = "content-" + Date.now();
            addMessage(`
                <div class="msg-row">
                    <div class="bot-msg-avatar">🤖</div>
                    <div class="bubble-wrap bot" style="max-width: 82%;">
                        <div class="bubble bot" style="width: 100%; display: flex; flex-direction: column; gap: 4px;" id="${uniqueId}-container">
                            </div>
                        <span class="bubble-time">${now()}</span>
                    </div>
                </div>
            `);

            const container = document.getElementById(`${uniqueId}-container`);

            let cleanTextReply = data.reply.replace(/\[PRODUCT_CARD\][\s\S]*?\[\/PRODUCT_CARD\]/g, '').trim();

            const closingText = "Anh/chị có muốn em tư vấn thêm về mẫu đồng hồ này, hoặc cần xem thêm các sản phẩm khác không ạ?";
            let mainContent = cleanTextReply;
            let finalAsk = "";

            if (cleanTextReply.includes(closingText)) {
                mainContent = cleanTextReply.replace(closingText, '').trim();
                finalAsk = closingText;
            }

            const textParts = mainContent.split(/(?=\b\d+\.\s)/g).map(p => p.trim()).filter(p => p.length > 0);
            let partIndex = 0;

            function renderFlow() {
                if (partIndex < textParts.length) {
                    const currentText = textParts[partIndex];

                    const textSpan = document.createElement('span');
                    textSpan.style.whiteSpace = "pre-line";
                    container.appendChild(textSpan);

                    typeWriterEffect(textSpan, currentText, 10, () => {
                        if (data.products && data.products[partIndex]) {
                            const p = data.products[partIndex];

                            const listWrapper = document.createElement('div');
                            listWrapper.className = "product-vertical-list inside-bubble";
                            listWrapper.style.margin = "4px 0 10px 0";
                            container.appendChild(listWrapper);

                                const skeletonItem = document.createElement('div');
                                skeletonItem.className = "product-grid-card skeleton-product";
                                skeletonItem.innerHTML = `
                                    <div class="card-thumb-wrap">
                                        <div class="skeleton-thumb" style="width:100%; height:135px; border-radius:8px;"></div>
                                    </div>
                                    <div class="card-body-info" style="gap:6px; padding: 10px 0 0 0;">
                                        <div class="skeleton-line" style="width: 85%; height: 12px;"></div>
                                        <div class="skeleton-line" style="width: 55%; height: 10px;"></div>
                                        <div class="skeleton-line" style="width: 45%; height: 14px; margin-top:4px;"></div>
                                    </div>
                                `;
                                listWrapper.appendChild(skeletonItem);
                                chatBody.scrollTop = chatBody.scrollHeight;

                                setTimeout(() => {
                                    skeletonItem.classList.remove('skeleton-product');
                                    skeletonItem.style.cursor = 'pointer';
                                    skeletonItem.onclick = () => { window.location.href = `/Product/Details/${p.id}`; };
                                    skeletonItem.innerHTML = `
                                        <div class="card-thumb-wrap">
                                            <img src="${p.imageUrl}" alt="${p.name}" onerror="this.onerror=null; this.src='/images/no-image.jpg';">
                                            <button class="card-heart-btn" onclick="event.stopPropagation();">
                                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                                            </button>
                                        </div>
                                        <div class="card-body-info">
                                            <h4 class="card-product-name" title="${p.name}">${p.name}</h4>
                                            <p class="card-brand-name">Thương hiệu: ${p.brandName || 'Đang cập nhật'}</p>
                                            <div class="card-footer-row">
                                                <span class="card-product-price">${p.price.toLocaleString('vi-VN')}đ</span>
                                                <button class="card-cart-btn" onclick="event.stopPropagation();">
                                                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
                                                </button>
                                            </div>
                                        </div>
                                    `;
                                    setTimeout(() => { skeletonItem.classList.add('visible'); }, 30);
                                    chatBody.scrollTop = chatBody.scrollHeight;
                                    partIndex++;
                                    setTimeout(renderFlow, 150);
                                }, 250);

                        } else {
                            partIndex++;
                            setTimeout(renderFlow, 200);
                        }
                    });
                }
                else if (finalAsk) {
                    const finalSpan = document.createElement('span');
                    finalSpan.style.whiteSpace = "pre-line";
                    finalSpan.style.display = "block";
                    finalSpan.style.marginTop = "8px";
                    finalSpan.style.borderTop = "1px dashed #e2e8f0";
                    finalSpan.style.paddingTop = "10px";
                    container.appendChild(finalSpan);

                    typeWriterEffect(finalSpan, finalAsk, 10, () => {
                        chatBody.scrollTop = chatBody.scrollHeight;
                    });
                    finalAsk = "";
                }
            }
            renderFlow();

        } catch (err) {
            showErrorMsg("⚠️ Máy chủ bận hoặc kết nối AI thất bại!");
            console.error('sendMessage exception:', err);
        }
    }

    function showErrorMsg(msgText) {
        document.getElementById("loading-message")?.remove();
        addMessage(`
            <div class="msg-row">
                <div class="bot-msg-avatar">🤖</div>
                <div class="bubble-wrap bot">
                    <div class="bubble bot">${msgText}</div>
                    <span class="bubble-time">${now()}</span>
                </div>
            </div>
        `);
    }

    function quickSend(message) {
        document.getElementById("user-input").value = message;
        sendMessage();
    }

    function escapeHtml(text) {
        return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
          // HÀM XỬ LÝ THÊM GIỎ HÀNG
       function handleAddToCart(productId) {
        console.log("Đang gửi yêu cầu thêm giỏ hàng cho ID:", productId);

        // Truyền trực tiếp ?Id= 
        fetch(`/Cart/AddToCart?Id=${productId}`, {
            method: 'POST',
            headers: {
                'Accept': 'application/json', // Ép Controller nhảy vào điều kiện trả về Json()
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Server phản hồi lỗi hệ thống');
            }
            return response.json(); // Chuyển kết quả trả về thành JSON Object
        })
        .then(result => {
            // Kiểm tra biến result.success từ Controller trả về
            if (result && result.success) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Đã thêm vào giỏ hàng',
                    showConfirmButton: false,
                    timer: 1500
                });

                
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Không thể thêm sản phẩm vào giỏ hàng.'
                });
            }
        })
        .catch(error => {
            console.error("Lỗi Fetch AddToCart:", error);
        });
    }

    // HÀM XỬ LÝ THÊM YÊU THÍCH (WISHLIST)
    function handleAddToWishlist(buttonElement, productId) {
        console.log("Đang gửi yêu cầu thêm yêu thích cho ID:", productId);

        
        fetch('/Home/AddToWishlist', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: `Id=${productId}`
        })
        .then(response => response.json())
        .then(result => {
            
            if (result.success) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: result.added ? 'success' : 'info',
                    title: result.message,
                    showConfirmButton: false,
                    timer: 1500
                });

               
                if (result.added) {
                    buttonElement.classList.add('active');
                } else {
                    buttonElement.classList.remove('active');
                }
            }
        })
        .catch(error => {
            console.error("Lỗi Fetch AddToWishlist:", error);
        });
    }
    // Tự động gọi đồng bộ lịch sử chat cũ ngay khi trang web tải xong
    document.addEventListener('DOMContentLoaded', loadHistory);
</script>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    #chat-bubble {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 65px;
        height: 65px;
        background: linear-gradient(135deg, #FFB347, #FE980F);
        color: white;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(254,152,15,0.45);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        z-index: 9999;
    }

        #chat-bubble:hover {
            transform: scale(1.1) translateY(-3px);
            box-shadow: 0 6px 24px rgba(254,152,15,0.6);
        }

    .bubble-icon {
        font-size: 26px;
        line-height: 1;
    }

    .bubble-text {
        font-size: 9px;
        font-weight: 700;
        margin-top: 3px;
        letter-spacing: 0.5px;
    }

    #chat-box {
        position: fixed;
        bottom: 110px;
        right: 30px;
        width: 385px;
        height: 580px;
        background: #f4f6f8;
        border-radius: 24px;
        display: none;
        flex-direction: column;
        overflow: hidden;
        z-index: 9999;
        box-shadow: 0 12px 40px rgba(0,0,0,0.15);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        border: 1px solid rgba(0, 0, 0, 0.04);
    }

    .chat-header {
        background: linear-gradient(135deg, #FE980F, #e6870d);
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .chat-header-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        border: 1px solid rgba(255,255,255,0.3);
    }

    .chat-header-info {
        flex: 1;
    }

    .chat-header-name {
        color: #fff;
        font-size: 14.5px;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .chat-header-status {
        color: rgba(255,255,255,0.85);
        font-size: 11px;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 2px;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #2ecc71;
        display: inline-block;
        box-shadow: 0 0 8px #2ecc71;
    }

    .chat-header-close {
        background: none;
        border: none;
        color: rgba(255,255,255,0.7);
        font-size: 18px;
        cursor: pointer;
        transition: color 0.2s;
    }

        .chat-header-close:hover {
            color: #fff;
        }

    .chat-body {
        flex: 1;
        padding: 16px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: #f4f6f8;
    }

    .msg-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        width: 100%;
    }

        .msg-row.user {
            flex-direction: row-reverse;
        }

    .bot-msg-avatar {
        width: 30px;
