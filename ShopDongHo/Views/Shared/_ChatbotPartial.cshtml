        transform: translateX(3px);
    }

    .skeleton-product {
        opacity: 1 !important;
        transform: none !important;
        background: #fafafa;
        border-color: #f0f0f0;
    }

    .skeleton-thumb {
        width: 56px;
        height: 56px;
        background: #eee;
        border-radius: 10px;
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
    }

    .skeleton-line {
        background: #eee;
        border-radius: 4px;
        position: relative;
        overflow: hidden;
    }

        .skeleton-thumb::after, .skeleton-line::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
            transform: translateX(-100%);
            animation: skeletonShimmer 1.2s infinite;
        }

    @@keyframes skeletonShimmer {
        100%

    {
        transform: translateX(100%);
    }

    }

    .typing-dots {
        display: flex;
        gap: 5px;
        align-items: center;
        padding: 12px 16px;
        background: #fff;
        border-radius: 20px;
        border-bottom-left-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.02);
    }

        .typing-dots span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #cbd5e1;
            animation: botTyping 1.2s infinite ease-in-out;
        }

            .typing-dots span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .typing-dots span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes botTyping {
        0%, 100%

    {
        transform: translateY(0);
        opacity: 0.4;
    }

    50% {
        transform: translateY(-6px);
        opacity: 1;
    }

    }

    #quick-messages {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 12px;
        background: #ffffff;
        border-top: 1px solid #edf2f7;
    }

