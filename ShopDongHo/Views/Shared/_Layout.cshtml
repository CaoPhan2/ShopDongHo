	}

		.search-box:focus-within {
			border-color: #0b2c5f;
			box-shadow: 0 0 0 3px rgba(11, 44, 95, 0.15);
		}

	.search-input-container {
		display: flex;
		align-items: center;
		flex: 1;
		padding-left: 6px;
	}

	/* Vùng hiển thị ảnh nhỏ mini nhúng đầu Input */
	#input-image-preview-container {
		display: none;
		align-items: center;
		background: #f1f5f9;
		border: 1px solid #e2e8f0;
		border-radius: 4px;
		padding: 2px 4px;
		margin-right: 6px;
	}

	#input-mini-preview {
		height: 24px;
		width: 24px;
		object-fit: cover;
		border-radius: 3px;
	}

	#remove-preview-btn {
		border: none;
		background: transparent;
		color: #ef4444;
		font-size: 16px;
		font-weight: bold;
		cursor: pointer;
		margin-left: 4px;
		padding: 0 2px;
		line-height: 1;
	}

		#remove-preview-btn:hover {
			color: #dc2626;
		}

	.search-box .search-input-container input[type="text"] {
		border: none !important;
		outline: none !important;
		padding: 6px 4px;
		width: 100%;
		font-size: 14px;
		color: #334155;
		background: transparent;
	}

	#header-image-btn {
		border: none;
		background: transparent;
		cursor: pointer;
		padding: 0 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.2s;
	}

		#header-image-btn i {
			font-size: 18px;
			color: #0b2c5f;
		}

		#header-image-btn:hover {
			transform: scale(1.1);
		}

	#search-submit-btn {
		background: #0b2c5f;
		color: #fff;
		border: none;
		border-radius: 4px;
		padding: 7px 14px;
		cursor: pointer;
		transition: background 0.2s;
	}

		#search-submit-btn:hover {
			background: #061b3d;
		}

	/* MÀN HÌNH CHỜ HIỆU ỨNG LÀM MỜ KÍNH (BACKDROP BLUR OVERLAY) */
	#fullscreen-loading-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(15, 23, 42, 0.75);
		backdrop-filter: blur(5px);
		z-index: 99999;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.loading-box {
		background: #ffffff;
		padding: 30px 40px;
		border-radius: 12px;
		box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
		text-align: center;
		max-width: 420px;
		width: 90%;
	}

	.loading-spinner {
		width: 45px;
		height: 45px;
		border: 4px solid #e2e8f0;
		border-top-color: #0b2c5f;
		border-radius: 50%;
		animation: spinAction 0.8s linear infinite;
		margin: 0 auto 15px auto;
	}

	.loading-box h3 {
		font-size: 18px;
		color: #0f172a;
		margin-bottom: 6px;
		font-weight: 600;
	}

	.loading-box p {
		font-size: 14px;
		color: #64748b;
		margin: 0;
	}

	@@keyframes spinAction {
		to

	{
		transform: rotate(360deg);
	}

	}

	/* PHẦN RIGHT KHÁC TRÊN HEADER */
	.header-right {
		display: flex;
		align-items: center;
		gap: 15px;
	}

		.header-right a {
			text-transform: uppercase;
			color: #0b2c5f;
			font-weight: 500;
		}

	/* LUXURY SLIDER KHỐI ĐỊNH DẠNG */
	.lux-slider {
		position: relative;
		height: 350px;
		overflow: hidden;
		background: #0b1d3a;
	}

		.lux-slider .slide {
			position: absolute;
			width: 100%;
			height: 100%;
			opacity: 0;
			transition: 0.8s ease;
		}

			.lux-slider .slide.active {
				opacity: 1;
				z-index: 2;
			}

			.lux-slider .slide img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transform: scale(1.1);
				transition: 5s ease;
			}

			.lux-slider .slide.active img {
				transform: scale(1);
			}

	.overlay {
		position: absolute;
		width: 100%;
		height: 100%;
		background: linear-gradient( to right, rgba(11,29,58,0.9) 30%, rgba(11,29,58,0.3) 70% );
		z-index: 1;
	}

	.content {
		position: absolute;
		top: 50%;
		left: 80px;
		transform: translateY(-50%);
		color: white;
		z-index: 2;
		max-width: 500px;
	}

		.content h1 {
			font-size: 52px;
			letter-spacing: 2px;
			margin-bottom: 15px;
			transform: translateY(40px);
			opacity: 0;
			transition: 0.6s;
		}

		.content p {
			font-size: 18px;
			margin-bottom: 25px;
			color: #cbd5e1;
			transform: translateY(40px);
			opacity: 0;
			transition: 0.8s;
		}

	.btn {
