<body>
	<header id="header">
		<div class="top-bar">
			<div class="flex-between">
				<span>Miễn phí vận chuyển đơn từ 500.000đ</span>
				<span>Đổi trả dễ dàng trong 7 ngày</span>
				<span>Bảo hành chính hãng 12 tháng</span>
				<span>Hotline: 0123 456 789</span>
			</div>
		</div>

		<div class="main-header">
			<div class="logo">
				<a asp-controller="Home" asp-action="Index">
					<img src="~/images/lg-removebg.png" alt="logo" />
				</a>
			</div>

			<nav class="nav-menu">
				<a asp-controller="Home" asp-action="Index">Trang Chủ</a>
				@await Component.InvokeAsync("Categories", new { viewName = "NavMenu" })
				@await Component.InvokeAsync("Brands", new { viewName = "NavMenu" })
				<a asp-controller="Home" asp-action="Wishlist">Yêu Thích</a>
				<a asp-controller="Home" asp-action="AboutUs">Về Chúng Tôi</a>
				<a asp-controller="Home" asp-action="Contact">Liên hệ</a>
			</nav>

			<div class="header-right">
				<form asp-controller="Product" asp-action="Search" method="post" class="search-box" id="header-search-form" enctype="multipart/form-data">

					<div class="search-input-container">
						<div id="input-image-preview-container">
							<img id="input-mini-preview" src="" alt="preview" />
							<button type="button" id="remove-preview-btn" title="Xóa ảnh chọn">&times;</button>
						</div>

						<input type="text" name="keyWord" placeholder="Tìm kiếm..." autocomplete="off" />
					</div>

					<button type="button" id="header-image-btn" title="Tìm bằng ảnh">
						<i class="fa fa-image" aria-hidden="true"></i>
					</button>
					<input type="file" id="header-image-input" accept="image/*" style="display:none" />

					<button type="submit" id="search-submit-btn"><i class="fa fa-search"></i></button>
				</form>

				<a asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
					<i class="fa fa-shopping-cart" style="font-size: 24px"></i>
				</a>
				@if (User.Identity?.IsAuthenticated ?? false)
				{
					<div class="dropdown">
						<span>Xin chào, @User.Identity.Name ▾</span>
						<div class="dropdown-menu">
							<a asp-action="History" asp-controller="Account">Lịch sử mua hàng</a>
							<a asp-action="UpdateAccount" asp-controller="Account">Cập nhật thông tin</a>
							<a asp-controller="Account" asp-action="Logout" onclick="return confirm('Bạn có muốn đăng xuất không?')">Đăng Xuất</a>
						</div>
					</div>
				}
				else
				{
					<a asp-controller="Account" asp-action="Login">Đăng Nhập</a>
				}
			</div>
		</div>
	</header>

	<div id="fullscreen-loading-overlay" style="display: none;">
		<div class="loading-box">
			<div class="loading-spinner"></div>
			<h3>AI đang phân tích hình ảnh của bạn...</h3>
			<p>Hệ thống đang trích xuất từ khóa, vui lòng đợi trong giây lát</p>
		</div>
	</div>

	<partial name="_HomeBannerPartial" />

	<section>
		<div class="container">
			<div class="row">
				@Html.Partial("_NotificationPartial")
				@RenderBody()
			</div>
		</div>
	</section>

	<partial name="_ChatbotPartial" />

	<footer id="footer">
		<partial name="_FooterPartial" />
	</footer>


	<script async defer crossorigin="anonymous" src="https://connect.facebook.net/vi_VN/sdk.js#xfbml=1&version=v25.0&appId=APP_ID"></script>
	<script src="~/js/jquery.js"></script>
	<script src="~/js/bootstrap.min.js"></script>
	<script src="~/js/price-range.js"></script>
	<script src="~/js/jquery.prettyPhoto.js"></script>
	<script src="~/js/main.js"></script>
	<script src="~/js/product.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.22/dist/sweetalert2.all.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

	<script>
		let slides = document.querySelectorAll(".lux-slider .slide");
		let next = document.querySelector(".next");
		let prev = document.querySelector(".prev");
		let dotsContainer = document.querySelector(".dots");
		let index = 0;

		if (slides.length > 0 && dotsContainer) {
			slides.forEach((_, i) => {
				let dot = document.createElement("span");
				if(i === 0) dot.classList.add("active");
				dot.addEventListener("click", () => showSlide(i));
				dotsContainer.appendChild(dot);
			});

			let dots = document.querySelectorAll(".dots span");

			function showSlide(i) {
				slides[index].classList.remove("active");
				dots[index].classList.remove("active");
				index = i;
				slides[index].classList.add("active");
				dots[index].classList.add("active");
			}

			if (next) {
				next.onclick = () => {
					let i = (index + 1) % slides.length;
					showSlide(i);
				};
			}

			if (prev) {
				prev.onclick = () => {
					let i = (index - 1 + slides.length) % slides.length;
					showSlide(i);
				};
			}

			setInterval(() => {
				if (next) next.click();
			}, 6000);
		}
	</script>

	<script>
		$(document).ready(function () {
			const $imgBtn = $('#header-image-btn');
			const $imgInput = $('#header-image-input');
			const $searchForm = $('#header-search-form');
			const $searchInput = $searchForm.find('input[name="keyWord"]');
			const $previewContainer = $('#input-image-preview-container');
			const $miniPreview = $('#input-mini-preview');
			const $removePreviewBtn = $('#remove-preview-btn');
			const $loadingOverlay = $('#fullscreen-loading-overlay');

			let selectedImageFile = null;

			if (!$imgBtn.length || !$imgInput.length || !$searchForm.length || !$searchInput.length) return;

			// Mở hộp thoại chọn tệp hệ thống
			$imgBtn.on('click', function () {
				$imgInput.click();
			});

			// Lắng nghe sự kiện sau khi tệp tin hình ảnh được nạp vào
			$imgInput.on('change', function () {
				const file = this.files && this.files[0];
				if (!file) return;

				if (!file.type.startsWith('image/')) {
					Swal.fire('Sai định dạng', 'Vui lòng chọn một file hình ảnh hợp lệ (jpg, png, webp).', 'warning');
					return;
				}

				const maxSize = 12 * 1024 * 1024; // Hỗ trợ tối đa 12MB theo cấu hình gốc
				if (file.size > maxSize) {
					Swal.fire('File quá lớn', 'Vui lòng chọn hình ảnh có dung lượng nhỏ hơn 12MB.', 'warning');
					return;
				}

				selectedImageFile = file;

				// Chuyển đổi dữ liệu ảnh để hiển thị mini-thumbnail trong lòng input
				const reader = new FileReader();
				reader.onload = function (e) {
					$miniPreview.attr('src', e.target.result);
					$previewContainer.css('display', 'flex');
					$searchInput.attr('placeholder', 'Thêm từ khóa bổ sung...');
					$searchInput.focus();
				};
				reader.readAsDataURL(file);
			});

			// Nhấn dấu X để hủy chọn hình ảnh
			$removePreviewBtn.on('click', function (e) {
				e.stopPropagation();
				selectedImageFile = null;
				$imgInput.val('');
				$previewContainer.css('display', 'none');
				$miniPreview.attr('src', '');
				$searchInput.attr('placeholder', 'Tìm kiếm...');
			});

			// Kiểm soát hành vi khi form thực hiện gửi dữ liệu (Submit)
					$searchForm.on('submit', async function (e) {
			if (!selectedImageFile) return; // Nếu không có ảnh, để form submit bình thường

			e.preventDefault();
			$loadingOverlay.fadeIn(200);

			const formData = new FormData();
			formData.append('image', selectedImageFile);
			formData.append('keyWord', $searchInput.val()); // Gửi thêm từ khóa text

			try {
				const resp = await fetch('/ImageSearch/Search', {
					method: 'POST',
					body: formData
				});

				const data = await resp.json();
				$loadingOverlay.fadeOut(200);

				if (data.success) {
					$searchInput.val(data.keywords);
					$searchForm.off('submit').submit(); // Submit lại form với từ khóa đã update
				} else {
					Swal.fire('Thông báo', data.message, 'warning');
				}
			} catch (err) {
				$loadingOverlay.fadeOut(200);
				Swal.fire('Lỗi', 'Không thể kết nối tới server.', 'error');
			}
		});
		});
	</script>

	<script>
		const currentPath = window.location.pathname.toLowerCase();
		document.querySelectorAll('.nav-menu a').forEach(link => {
			const linkPath = new URL(link.href).pathname.toLowerCase();
			if (currentPath === linkPath) {
				link.classList.add('active');
			} else {
				link.classList.remove('active');
			}
		});
	</script>

	@await RenderSectionAsync("Scripts", required: false)
</body>

<style>
