		background: white;
		color: #0b1d3a;
		border-radius: 30px;
		text-decoration: none;
		font-weight: bold;
		transition: 1s;
	}

	.lux-slider .slide.active .content h1,
	.lux-slider .slide.active .content p,
	.lux-slider .slide.active .btn {
		transform: translateY(0);
		opacity: 1;
	}

	.controls span {
