		background: #fff;
		display: none;
		flex-direction: column;
		box-shadow: 0 3px 10px rgba(0,0,0,0.1);
		z-index: 100;
	}

		.dropdown-menu a {
			text-transform: uppercase;
			color: #0b2c5f;
			font-weight: 500;
			padding: 8px 15px;
			white-space: nowrap;
			display: block;
		}

	.dropdown:hover .dropdown-menu {
		display: block;
	}

	/* KHU VỰC KHUNG TÌM KIẾM CẢI TIẾN */
	.search-box {
		display: flex;
		align-items: center;
		border: 1px solid #cbd5e1;
		border-radius: 6px;
		background: #ffffff;
		padding: 2px;
		min-width: 320px;
