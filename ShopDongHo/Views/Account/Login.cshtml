@using ShopDongHo.Models.ViewModel
@model LoginViewModel
@{
    ViewData["title"] = "Login";
}

<section class="login-section">

    <div class="login-box">
        <h2>Đăng nhập</h2>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <form asp-action="Login" asp-controller="Account">

            <div class="form-group">
                <label>User Name</label>
                <input asp-for="UserName" class="form-control" placeholder="Nhập username..." />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu..." />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-login">Đăng nhập</button>
        </form>

        <a class="btn-google" asp-action="LoginByGoogle" asp-controller="Account">
            <i class="fa-brands fa-google"></i> Đăng nhập với Google
        </a>

        <div class="extra-links">
            <a asp-action="Create" asp-controller="Account">Tạo tài khoản</a>
            <a asp-action="ForgetPass" asp-controller="Account">Quên mật khẩu?</a>
        </div>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
