@using ShopDongHo.Models
@model UserModel
@{
    ViewData["title"] = "Register";
}

<section class="register-section">

    <div class="register-box">
        <h2>Tạo tài khoản</h2>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <form asp-action="Create" asp-controller="Account">

            <div class="form-group">
                <label>User Name</label>
                <input asp-for="UserName" class="form-control" placeholder="Nhập username..." />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email..." />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu..." />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-register">Tạo tài khoản</button>
        </form>

        <div class="extra-links">
            <a asp-action="Login" asp-controller="Account">Đã có tài khoản?</a>
        </div>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<style>
	.register-section {
		min-height: 100vh;
		display: flex;
		justify-content: center;
		align-items: center;
		background: #f5f5f5;
	}

	.register-box {
		width: 100%;
		max-width: 400px;
		background: #fff;
		padding: 30px 25px;
		border-radius: 8px;
		border: 1px solid #eee;
	}

		.register-box h2 {
			text-align: center;
			margin-bottom: 20px;
			font-weight: 600;
		}

	.form-group {
		margin-bottom: 15px;
	}

	.form-control {
		width: 100%;
		height: 42px;
		border-radius: 6px;
		border: 1px solid #ddd;
		padding: 0 10px;
	}

	.btn-register {
		width: 100%;
		background: #0b1f3a;
		color: #fff;
		border: none;
		height: 42px;
		border-radius: 6px;
		margin-top: 10px;
		cursor: pointer;
	}

		.btn-register:hover {
			background: #222;
		}

	.extra-links {
		margin-top: 15px;
		text-align: center;
	}

		.extra-links a {
			font-size: 14px;
			color: #555;
			text-decoration: none;
		}
</style>