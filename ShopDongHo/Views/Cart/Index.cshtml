@using ShopDongHo.Models.ViewModel
@model CartItemViewModel

<section class="lux-cart">

    <div class="container">

        <div class="cart-page-header">
            <h1>GIỎ HÀNG</h1>
            <p>Trang chủ / Giỏ hàng</p>
        </div>

        @if (Model.CartItems.Any())
        {
            <div class="cart-layout">

                <!-- LEFT -->
                <div class="cart-products">

                    <div class="cart-head">
                        <div class="c-product">Sản phẩm</div>
                        <div class="c-price">Đơn giá</div>
                        <div class="c-qty">Số lượng</div>
                        <div class="c-total">Thành tiền</div>
                        <div class="c-remove"></div>
                    </div>

                    @foreach (var item in Model.CartItems)
                    {
                        <div class="cart-item">

                            <div class="c-product">

                                <img src="~/media/products/@item.Image"
                                     alt="@item.ProductName">

                                <div>
                                    
                                    <h5>@item.ProductName</h5>
                                    <span>Mã SP: @item.ProductId</span>
                                </div>

                            </div>

                            <div class="c-price">
                                @item.Price.ToString("#,##0 VNĐ")
                            </div>

                            <div class="c-qty">

                                <div class="qty-box">

                                    <a asp-controller="Cart"
                                       asp-action="Decrease"
                                       asp-route-id="@item.ProductId">
                                        −
                                    </a>

                                    <span>@item.Quantity</span>

                                    <a asp-controller="Cart"
                                       asp-action="Increase"
                                       asp-route-id="@item.ProductId">
                                        +
                                    </a>

                                </div>

                            </div>

                            <div class="c-total">
                                @((item.Price * item.Quantity).ToString("#,##0 VNĐ"))
                            </div>

                            <div class="c-remove">

                                <a asp-controller="Cart"
                                   asp-action="Remove"
                                   asp-route-id="@item.ProductId"
                                   onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
                                    <i class="fa fa-trash"></i>
                                </a>

                            </div>

                        </div>
                    }

                    <div class="cart-footer-buttons">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn-light">
                            ← Tiếp tục mua sắm
                        </a>

                        <a asp-controller="Cart"
                           asp-action="Clear"
                           onclick="return confirm('Xóa toàn bộ giỏ hàng?')"
                           class="btn-danger-outline">
                            Xóa tất cả
                        </a>

                    </div>

                </div>

                <!-- RIGHT -->

                <div class="cart-summary">

                    <h5>TỔNG TIỀN ĐƠN HÀNG</h5>

                    <div class="summary-row">
                        <span>Tạm tính</span>
                        <strong>@Model.GrandTotal.ToString("#,##0 VNĐ")</strong>
                    </div>

                    <div class="summary-row">
                        <span>Phí vận chuyển</span>
                        <strong>Miễn phí</strong>
                    </div>
                    <div class="summary-row text-success">
                        <span>Giảm giá</span>
                        <span>-@(((decimal)ViewBag.Discount).ToString("#,##0"))đ</span>
                    </div>
                    <div class="cs-coupon">
                        <input type="text" class="coupon-value" placeholder="Nhập mã giảm giá..." />
                        <button class="btn-apply-coupon">Áp dụng</button>
                    </div>

                    @if (Context.Request.Cookies["CouponTitle"] != null)
                    {
                        <span class="cs-success">
                            @Context.Request.Cookies["CouponTitle"]
                        </span>
                    }
                    <hr>

                    <div class="summary-row total">
                        <span>Tổng cộng</span>
                        <strong>@Model.GrandTotal.ToString("#,##0 VNĐ")</strong>
                    </div>

                    <a asp-controller="Checkout"
                       asp-action="Index"
                       class="btn-checkout">

                        TIẾN HÀNH THANH TOÁN →

                    </a>
                    <form method="POST"
                          asp-action="CreatePaymentUrlVnpay"
                          asp-controller="Payment">

                        <input type="hidden"
                               name="Amount"
                               value="@Model.GrandTotal" />

                        <input type="hidden"
                               name="OrderType"
                               value="other" />

                        <input type="hidden"
                               name="OrderDescription"
                               value="Thanh toán VNPAY" />

                        <input type="hidden"
                               name="Name"
                               value="@User.Identity?.Name" />

                        <button type="submit" class="btn-vnpay-lux">

                            THANH TOÁN NHANH VNPAY
                            
                        </button>

                    </form>

                    <div class="benefits">

                        <div>
                            <i class="fa fa-shield"></i>
                            <span>Chính hãng</span>
                        </div>

                        <div>
                            <i class="fa fa-refresh"></i>
                            <span>Đổi trả</span>
                        </div>

                        <div>
                            <i class="fa fa-certificate"></i>
                            <span>Bảo hành</span>
                        </div>

                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="empty-cart">

                <i class="fa fa-shopping-bag"></i>

                <h3>Giỏ hàng đang trống</h3>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn-checkout">

                    MUA SẮM NGAY

                </a>

            </div>
        }

    </div>

</section>

@section Scripts {
    <script>
        $(".btn-apply-coupon").click(function(){
            var coupon_value = $(".coupon-value").val();
            $.ajax({
                url: '@Url.Action("GetCoupon", "Cart")',
                type: 'POST',
                data: {
                    coupon_value: coupon_value
                },
                success: function(result) {
                    if(result.success){
                        Swal.fire(result.message);
                        location.reload();
                    }else{
                        Swal.fire(result.message);
                    }
                }

            });
        })
    </script>
}
